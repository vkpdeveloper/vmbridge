{
  "name": "vmbridge",
  "version": "1.1.17",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "VMBRIDGE_DEV=1 bun --watch apps/cli/src/index.ts run",
    "typecheck": "tsc && tsc -p apps/web",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "test:workerd": "bun apps/server/dev/workerd/run.ts",
    "build": "bun scripts/build.ts",
    "compile": "bun scripts/compile.ts",
    "test:workers": "bun apps/server/dev/workers/run.ts",
    "deploy": "bunx wrangler@4.166.0 deploy"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@types/bun": "1.4.5",
    "bun-plugin-tailwind": "0.1.2",
    "typescript": "~5.9.3"
  },
  "cloudflare": {
    "bindings": {
      "VMBRIDGE_PASSWORD": {
        "description": "The dashboard password, at least 12 characters. Change this secret later to change the password."
      },
      "VMBRIDGE_ENCRYPTION_KEY": {
        "description": "Encrypts your keys and sign-ins. Run `openssl rand -base64 32`, or use a passphrase of at least 32 characters. Keep a copy: without it the saved data can't be read."
      }
    }
  }
}
